# Copy to apps/api/.env for local development. Never commit .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Set to false when the API is not behind a proxy (local development).
TRUST_PROXY=true

# PostgreSQL 13+. Managed providers usually need DATABASE_SSL=true.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_dev
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# 32 random bytes, base64. Encrypts patient phone numbers and message bodies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store it in your host's secret manager. Losing it makes stored phone numbers unreadable.
DATA_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API with cookies.
APP_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:5173
# Optional. Leave empty unless you need the cookie on a parent domain.
COOKIE_DOMAIN=

# mock = no network calls (local dev, demos). meta = WhatsApp Cloud API.
MESSAGING_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved utility template with one body variable, used for notifications outside the 24h window.
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Staff WhatsApp simulator. Defaults to on for mock outside production.
SIMULATOR_ENABLED=true
# PayU merchant key and salt for online payments. Leave both empty to keep online payments off.
# Start with PAYU_ENV=test and the test key and salt. Use production only after PayU approves the live account.
# The salt is a secret: never commit it, and never paste it into chat or tickets.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# Runs the outbox worker inside this process.
WORKER_ENABLED=true
OUTBOX_POLL_MS=5000

DEFAULT_COUNTRY_CODE=91
REPORT_LINK_TTL_HOURS=72
REPORT_LINK_MAX_USES=10
MAX_REPORT_BYTES=5242880
# Auth endpoints (login, signup) per IP per minute.
RATE_LIMIT_AUTH_PER_MINUTE=10
LOG_LEVEL=debug
